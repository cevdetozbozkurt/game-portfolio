@inject IJSRuntime JS

<div class="world-frame">
    <div class="world-hud"><span><span class="status-dot"></span> THE CREATIVE WILDS</span><span class="world-hearts" aria-label="Three pixel hearts">♥ ♥ ♥</span></div>
    <div class="world-scene @(playing ? "is-playing" : "")" tabindex="0" role="group" aria-label="Pixel forest exploration game" aria-describedby="game-instructions" @ref="gameSurface" @onkeydown="HandleKey">
        <img class="landscape" src="assets/world.svg" alt="An original pixel art floating forest island, with a moonlit mountain range, a little cabin and a glowing waterfall" width="640" height="500" fetchpriority="high" />
        <div class="world-orb orb-one" aria-hidden="true"></div><div class="world-orb orb-two" aria-hidden="true"></div><div class="world-orb orb-three" aria-hidden="true"></div>
        <div class="water-spark" aria-hidden="true"></div>
        @foreach (var gem in ExplorationState.GemPositions)
        {
            @if (!game.IsCollected(gem)) { <span class="world-gem" style="left: @(8 + gem * 7)%" aria-hidden="true">◆</span> }
        }
        <img class="world-player @(facingLeft ? "facing-left" : "")" style="left: @(8 + game.Position * 7)%" src="assets/avatar.svg" alt="Pixel explorer" width="32" height="40" />
        @if (!playing) { <div class="world-bubble">Every adventure starts<br />with a little curiosity.</div> }
        @if (game.Completed) { <div class="achievement" role="status"><span>✦ QUEST COMPLETE</span><b>Curiosity rewarded.</b><small>You found all 3 gems. Keep exploring ↓</small></div> }
    </div>
    <div class="world-console"><div class="console-copy"><span class="console-label">SIDE QUEST / 001</span><p id="game-instructions">@(playing ? "Use ← → or A / D to collect the gems." : "A tiny world. Go on, explore it.")</p></div>
        @if (!playing) { <button class="play-button" @onclick="Start">Let's play <span aria-hidden="true">▶</span></button> }
        else { <span class="gem-score" role="status" aria-label="Gems collected">◆ @game.CollectedCount / 3</span> }
    </div>
    @if (playing) { <div class="game-controls"><div><button class="icon-button" @onclick="() => Move(-1)" aria-label="Move left">←</button><button class="icon-button" @onclick="() => Move(1)" aria-label="Move right">→</button></div><button class="small-button" @onclick="Reset">Restart ↺</button><button class="small-button" @onclick="ToggleSound" aria-pressed="@soundEnabled.ToString().ToLowerInvariant()">Sound @(soundEnabled ? "on" : "off")</button><button class="small-button" @onclick="Stop">Exit ×</button></div> }
</div>

@code {
    private readonly ExplorationState game = new();
    private ElementReference gameSurface;
    private bool playing, facingLeft, soundEnabled;
    private async Task Start() { playing = true; await gameSurface.FocusAsync(preventScroll: true); await JS.InvokeVoidAsync("portfolio.gameKeys", gameSurface, true); }
    private async Task Stop() { playing = false; game.Reset(); await JS.InvokeVoidAsync("portfolio.gameKeys", gameSurface, false); }
    private async Task Reset() { game.Reset(); facingLeft = false; await gameSurface.FocusAsync(preventScroll: true); }
    private async Task ToggleSound() { soundEnabled = !soundEnabled; if (soundEnabled) await JS.InvokeVoidAsync("portfolio.chime", false); }
    private async Task Move(int direction) { if (!playing) return; facingLeft = direction < 0; if (game.Move(direction) && soundEnabled) await JS.InvokeVoidAsync("portfolio.chime", game.Completed); }
    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (!playing) return;
        if (e.Key is "ArrowLeft" or "a" or "A") await Move(-1);
        else if (e.Key is "ArrowRight" or "d" or "D") await Move(1);
        else if (e.Key == "Escape") await Stop();
    }
}

@page "/"
@inject IJSRuntime JS

<PageTitle>Cevdet Eren Özbozkurt — Game Developer</PageTitle>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
    <div class="nav-shell">
        <a class="wordmark" href="#home" aria-label="Eren.dev home"><span class="logo-icon" aria-hidden="true">✚</span> eren<span>.dev</span><span class="logo-cursor">_</span></a>
        <nav aria-label="Main navigation" class="@(menuOpen ? "nav-links is-open" : "nav-links")">
            <a href="#projects" @onclick="CloseMenu">Projects</a><a href="#about" @onclick="CloseMenu">About</a><a href="#skills" @onclick="CloseMenu">Skills</a><a href="#journey" @onclick="CloseMenu">Journey</a>
        </nav>
        <div class="nav-actions">
            <button class="icon-button motion-toggle" @onclick="ToggleMotion" aria-pressed="@motionPaused.ToString().ToLowerInvariant()" aria-label="Pause ambient animations" title="Pause ambient animations">@(motionPaused ? "▷" : "Ⅱ")</button>
            <a class="nav-contact" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
            <button class="icon-button menu-toggle" @onclick="() => menuOpen = !menuOpen" aria-expanded="@menuOpen.ToString().ToLowerInvariant()" aria-label="Toggle navigation">@(menuOpen ? "×" : "☰")</button>
        </div>
    </div>
</header>
<main id="main">
    <section class="hero shell" id="home" aria-labelledby="hero-title">
        <div class="hero-copy">
            <div class="eyebrow"><span class="status-dot"></span> GAME DEVELOPER & CREATIVE BUILDER</div>
            <p class="hello">Hey, I'm Cevdet Eren <span class="tiny-star" aria-hidden="true">✦</span></p>
            <h1 id="hero-title">A little code.<br />A whole<br /><span>new world.</span></h1>
            <p class="hero-description">I turn ideas into things you can play.<br class="desktop-break" /> Game development, curious experiments,<br class="desktop-break" /> and a few pixels of personality.</p>
            <div class="hero-actions"><a class="button button-primary" href="#projects"><span aria-hidden="true">▶</span> Explore my work <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">Meet the player <span aria-hidden="true">↓</span></a></div>
            <div class="hero-caption"><span aria-hidden="true">⌖</span> Based in Türkiye <span class="caption-divider">/</span> Built with curiosity</div>
        </div>
        <div class="hero-world"><PixelWorld /></div>
        <a href="#projects" class="scroll-hint"><span class="scroll-mouse" aria-hidden="true"></span> SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a>
        <span class="hero-side-note" aria-hidden="true">PORTFOLIO · SAVE FILE 001</span>
    </section>
    <div class="tool-strip"><div class="shell tool-strip-inner"><span class="tool-strip-label">TOOLS OF THE TRADE</span><span class="tool-name"><b>◇</b> Unity</span><span class="tool-name"><b class="tool-csharp">C#</b> C#</span><span class="tool-name"><b>⌘</b> .NET</span><span class="tool-name"><b>⌥</b> Git & GitHub</span><span class="strip-note">Ideas → code → play.</span></div></div>
    <section class="section shell" id="projects" aria-labelledby="projects-title">
        <div class="section-topline"><span class="section-index">01 / THE GAME LIBRARY</span><span class="micro-copy">A FEW WORLDS I'VE WORKED ON</span></div>
        <div class="section-heading"><div><h2 id="projects-title">Select your adventure<span class="accent">.</span></h2><p>Different worlds. Same love for making things work.</p></div><a class="text-link" href="@PortfolioContent.GitHub" target="_blank" rel="noopener noreferrer">All repositories <span aria-hidden="true">↗</span></a></div>
        <div class="filter-row" role="group" aria-label="Filter projects">
            @foreach (var category in categories) { <button class="filter @(activeCategory == category ? "active" : "")" aria-pressed="@((activeCategory == category).ToString().ToLowerInvariant())" @onclick="() => activeCategory = category">@(category == "All" ? "All projects" : category) <span>@PortfolioContent.Filter(category).Count().ToString("00")</span></button> }
            <span class="filter-count" role="status">@PortfolioContent.Filter(activeCategory).Count() projects loaded</span>
        </div>
        <div class="project-grid">
            @foreach (var project in PortfolioContent.Filter(activeCategory))
            {
                <article class="project-card @project.Id" @key="project.Id">
                    <button class="project-art-button" @onclick="() => OpenProject(project)" aria-label="View @project.Title project details"><div class="project-art">
                        @if (project.Image is not null) { <img src="@project.Image" alt="@project.ImageAlt" loading="lazy" width="640" height="360" /> }
                        else { <div class="ar-concept" aria-hidden="true"><div class="room-grid"></div><div class="scan-cube"></div><span class="scan-cross">+</span><span class="scan-label">MAPPING THE REAL WORLD</span></div> }
                        <span class="art-label">@(project.Image is null ? "CONCEPT ART" : project.Id == "square" ? "GAME ARTWORK" : "IN-GAME CAPTURE")</span><span class="art-open" aria-hidden="true">↗</span>
                    </div></button>
                    <div class="project-body"><p class="project-context"><span class="small-square"></span>@project.Context</p><h3>@project.Title</h3><p class="project-description">@project.Description</p><div class="project-bottom"><div class="tags">@foreach(var tech in project.Technologies.Take(2)) { <span>@tech</span> }</div><button class="project-details-link" @onclick="() => OpenProject(project)" aria-label="Read about @project.Title">Details <span aria-hidden="true">↗</span></button></div></div>
                </article>
            }
        </div>
        <div class="library-footnote"><span aria-hidden="true">✦</span> There's always another idea in the making. <a href="@PortfolioContent.ItchIo" target="_blank" rel="noopener noreferrer">Find more on itch.io ↗</a></div>
    </section>
    <section class="about-wrap" id="about" aria-labelledby="about-title"><div class="section shell about-grid">
        <div class="player-card"><div class="player-card-top"><span>PLAYER PROFILE</span><span class="accent">P1</span></div><div class="portrait-stage"><div class="portrait-ring"></div><img src="assets/avatar.svg" alt="A pixel adventurer with dark hair, a green jacket and a backpack" width="160" height="200" /><span class="portrait-spark spark-one">✦</span><span class="portrait-spark spark-two">+</span></div><h3>Cevdet Eren<br />Özbozkurt</h3><p>Game & Software Developer</p><div class="player-attributes"><span><small>MAIN CLASS</small>Game developer</span><span><small>HOME BASE</small>Türkiye</span></div><div class="player-motto"><span class="status-dot"></span> Always learning. Always building.</div></div>
        <div class="about-copy"><span class="section-index">02 / MEET THE PLAYER</span><h2 id="about-title">Curiosity is my<br /><span class="accent">favorite skill.</span></h2><p>I'm Cevdet Eren Özbozkurt, a computer engineering graduate from Fırat University, and a developer who loves turning an idea into something you can interact with.</p><p>Games are where code, art and a little bit of magic meet. From game jams to arcade idle loops, I enjoy figuring out what makes an experience feel good to play.</p><p>Outside of games, I explore embedded systems, artificial intelligence and software development. Different tools, same instinct: build it, try it, make it better.</p><div class="about-facts"><span><b>Unity & C#</b>My everyday toolkit</span><span><b>From idea to interaction</b>What keeps me building</span></div><a class="text-link" href="@PortfolioContent.LinkedIn" target="_blank" rel="noopener noreferrer">A little more about me on LinkedIn ↗</a></div>
    </div></section>
    <section class="section shell" id="skills" aria-labelledby="skills-title"><div class="section-topline"><span class="section-index">03 / THE SKILL TREE</span><span class="micro-copy">CLICK A NODE TO INSPECT</span></div><div class="section-heading"><div><h2 id="skills-title">An ever-growing inventory<span class="accent">.</span></h2><p>The tools I build with, and the paths I'm exploring.</p></div></div><SkillTree /></section>
    <section class="section shell journey-section" id="journey" aria-labelledby="journey-title"><div class="section-topline"><span class="section-index">04 / QUEST LOG</span><span class="micro-copy">LEARNING BY BUILDING</span></div><div class="section-heading"><div><h2 id="journey-title">Every project adds a little XP<span class="accent">.</span></h2></div></div><div class="journey-list">
        <article><span class="quest-number">01</span><div><span class="quest-type">GAME JAMS</span><h3>Making something from nothing.</h3><p>Collaborating under a deadline, building gameplay and animating Square for Mağara Jam #5.</p></div><span class="quest-tag">TEAMWORK + CREATIVITY</span></article>
        <article><span class="quest-number">02</span><div><span class="quest-type">INTERNSHIP</span><h3>Finding the fun in the loop.</h3><p>Developing WoodsMan, an arcade idle game, during a summer internship.</p></div><span class="quest-tag">UNITY + GAMEPLAY</span></article>
        <article><span class="quest-number">03</span><div><span class="quest-type">EXPLORATION</span><h3>Beyond the game screen.</h3><p>Building Rocket-San with the IEEE club and exploring augmented reality through AR Room Scanner.</p></div><span class="quest-tag">EXPERIMENT + LEARN</span></article>
    </div></section>
    <section class="contact-section shell" id="contact" aria-labelledby="contact-title"><div class="contact-stars" aria-hidden="true">✦ <span>+</span> ✧</div><span class="section-index">05 / NEXT QUEST</span><h2 id="contact-title">Great things start<br />with a <span class="accent">hello.</span></h2><p>Have a game idea, a project, or just want to talk shop?<br />I'd love to hear from you.</p><a class="button button-primary" href="mailto:@PortfolioContent.Email">Say hello <span aria-hidden="true">↗</span></a><a class="email-link" href="mailto:@PortfolioContent.Email">@PortfolioContent.Email</a><div class="contact-socials"><a href="@PortfolioContent.GitHub" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="@PortfolioContent.LinkedIn" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="@PortfolioContent.ItchIo" target="_blank" rel="noopener noreferrer">itch.io ↗</a></div></section>
</main>
<footer class="site-footer shell"><a href="#home" class="wordmark">eren<span>.dev</span>_</a><p>© @DateTime.UtcNow.Year Cevdet Eren Özbozkurt</p><span>Made with C# & a little imagination <span class="accent">✦</span></span><a href="#home" class="back-top" aria-label="Back to top">↑</a></footer>
<dialog id="project-dialog" class="project-dialog" @ref="projectDialog" aria-labelledby="dialog-title">
    @if (selectedProject is not null)
    {
        <div class="dialog-top"><span class="section-index">PROJECT FILE / @selectedProject.Context</span><button class="icon-button" @onclick="CloseProject" aria-label="Close project details">×</button></div>
        @if (selectedProject.Image is not null) { <img class="dialog-image" src="@selectedProject.Image" alt="@selectedProject.ImageAlt" /> }
        <div class="dialog-copy"><h2 id="dialog-title">@selectedProject.Title</h2><p>@selectedProject.Detail</p><div class="tags">@foreach(var tech in selectedProject.Technologies) { <span>@tech</span> }</div><div class="dialog-actions">
        @if (selectedProject.SourceUrl is not null) { <a class="button button-secondary" href="@selectedProject.SourceUrl" target="_blank" rel="noopener noreferrer">View source ↗</a> }
        @if (selectedProject.PlayUrl is not null) { <a class="button button-primary" href="@selectedProject.PlayUrl" target="_blank" rel="noopener noreferrer">Get the game ↗</a> }
        @if (selectedProject.SourceUrl is null && selectedProject.PlayUrl is null) { <a class="button button-primary" href="mailto:@PortfolioContent.Email?subject=About%20AR%20Room%20Scanner">Ask me about this project ↗</a> }
        </div></div>
    }
</dialog>
@code {
    private readonly string[] categories = ["All", "Games", "Experiments"];
    private string activeCategory = "All";
    private bool menuOpen, motionPaused, openDialogAfterRender;
    private PortfolioProject? selectedProject;
    private ElementReference projectDialog;
    private void CloseMenu() => menuOpen = false;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { motionPaused = await JS.InvokeAsync<bool>("portfolio.initialize"); StateHasChanged(); }
        if (openDialogAfterRender) { openDialogAfterRender = false; await JS.InvokeVoidAsync("portfolio.openDialog", projectDialog); }
    }
    private void OpenProject(PortfolioProject project) { selectedProject = project; openDialogAfterRender = true; }
    private async Task CloseProject() => await JS.InvokeVoidAsync("portfolio.closeDialog", projectDialog);
    private async Task ToggleMotion() { motionPaused = !motionPaused; await JS.InvokeVoidAsync("portfolio.setMotion", motionPaused); }
}
